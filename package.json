{
  "name": "myts",
  "version": "7.2.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:browser": "node --test tests/*.browser.mjs",
    "check:release": "node scripts/release-check.mjs",
    "build": "node scripts/release-check.mjs && wrangler deploy --config wrangler.jsonc --dry-run --outdir tmp/review-build",
    "deploy": "node scripts/release-check.mjs --deploy && wrangler deploy --config wrangler.jsonc"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
