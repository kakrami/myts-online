{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myts",
  "main": "./worker.js",
  "compatibility_date": "2026-09-09",
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *",
      "1-59/5 * * * *",
      "0-59/2 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MYTS_RUNTIME",
        "class_name": "MyTSRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "myts-runtime-v1",
      "new_sqlite_classes": [
        "MyTSRuntime"
      ]
    }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true
  }
}
