{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myts-online",
  "main": "worker.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "limits": {
    "cpu_ms": 30000
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myts-v7-rebuild-data",
      "database_id": "60f77502-33d4-41d6-80d4-1c5577ebba76"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC",
        "class_name": "SyncRuntime"
      }
    ]
  },
  "exports": {
    "MyTSRuntime": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "SyncRuntime": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "preview_urls": false
}
